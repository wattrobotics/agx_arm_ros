<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="agx_arm_ros2_control" params="name initial_positions_file arm_type effector_type revo2_type">
    <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}" />

    <ros2_control name="${name}" type="system">
      <hardware>
        <!-- 항상 실물 팔: JTC 명령을 control/joint_states로 발행하고, 실측을
             feedback/joint_states에서 구독해 상태 인터페이스에 반영한다.
             nero_hardware_interface.py(= ROS1 innfos_node 역할)가 양 토픽 ↔ Nero 브리지. -->
        <plugin>joint_state_topic_hardware_interface/JointStateTopicSystem</plugin>
        <param name="joint_commands_topic">control/joint_states</param>
        <param name="joint_states_topic">feedback/joint_states</param>
        <param name="sum_wrapped_joint_states">false</param>
      </hardware>

      <joint name="joint1">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="joint2">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="joint3">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="joint4">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="joint5">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="joint6">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>

      <xacro:if value="${arm_type == 'nero'}">
        <joint name="joint7">
          <command_interface name="position" />
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort" />
        </joint>
      </xacro:if>
    </ros2_control>
  </xacro:macro>
</robot>
